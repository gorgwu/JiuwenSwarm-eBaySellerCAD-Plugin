# Copy this template to .env in the plugin folder. Keep .env private.
# Choose one environment and fill in only that environment's credentials.
# Production uses a real seller account. Sandbox uses test accounts and test data.

# Set EBAY_ENV to 'production' for your real seller account, or 'sandbox' for testing.
EBAY_ENV=production

# PRODUCTION — needed only when EBAY_ENV=production
# Find these in your Production keyset: App ID = Client ID; Cert ID = Client Secret.
EBAY_PRODUCTION_CLIENT_ID=
EBAY_PRODUCTION_CLIENT_SECRET=
# RuName is the eBay Redirect URL name configured for this keyset.
EBAY_PRODUCTION_RUNAME=
# Run: python common/setup_oauth.py --environment production
# The setup script saves the seller refresh token here after you authorize it.
EBAY_PRODUCTION_USER_REFRESH_TOKEN=
# Optional short-lived alternative; leave blank when using a refresh token.
EBAY_PRODUCTION_USER_ACCESS_TOKEN=

# SANDBOX — needed only for developer testing when EBAY_ENV=sandbox
# Use the Sandbox App ID, Cert ID and RuName, separate from Production.
EBAY_SANDBOX_CLIENT_ID=
EBAY_SANDBOX_CLIENT_SECRET=
EBAY_SANDBOX_RUNAME=
# Run: python common/setup_oauth.py --environment sandbox
# The setup script saves the Sandbox seller refresh token here.
EBAY_SANDBOX_USER_REFRESH_TOKEN=
# Optional short-lived alternative; leave blank when using a refresh token.
EBAY_SANDBOX_USER_ACCESS_TOKEN=
# Only for tests requiring a separate Sandbox buyer. Authorize it with:
# python common/setup_oauth.py --environment sandbox --account buyer
EBAY_SANDBOX_BUYER_REFRESH_TOKEN=

# The plugin itself targets English Canada, do not change this value.
EBAY_MARKETPLACE_ID=EBAY_CA
